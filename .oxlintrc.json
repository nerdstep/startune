{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "ui": "@/components/ui",
      "note": "See DESIGN.md for the design system and approved exceptions."
    }
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/.impeccable/**",
    "**/.tanstack/**",
    "**/.wrangler/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/public/**",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts"
  ],
  "rules": {
    "curly": ["error", "all"],
    "default-param-last": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "import/no-absolute-path": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "no-await-in-loop": "error",
    "no-bitwise": "error",
    "no-constant-binary-expression": "error",
    "no-else-return": "error",
    "no-implicit-coercion": "error",
    "no-lonely-if": "error",
    "no-loss-of-precision": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": "error",
    "no-plusplus": "error",
    "no-shadow": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-useless-concat": "error",
    "no-useless-escape": "error",
    "one-var": ["error", "never"],
    "operator-assignment": ["error", "always"],
    "prefer-exponentiation-operator": "error",
    "prefer-object-spread": "error",
    "react/jsx-key": "error",
    "react/no-children-prop": "error",
    "react/no-danger": "off",
    "react/jsx-no-constructed-context-values": "error",
    "react/rules-of-hooks": "error",
    "react/self-closing-comp": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/incompatible-library": "off",
    "react/preserve-manual-memoization": "off",
    "react/no-object-type-as-default-prop": "error",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/use-memo": "off",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false,
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-inferrable-types": "error",
    // Narrow with a guard or restructure, so a wrong assumption fails where it's made.
    "typescript/no-non-null-assertion": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-enum-initializers": "error",
    "typescript/prefer-for-of": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/numeric-separators-style": "off",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-number-properties": "error",
    "vitest/expect-expect": "off",
    "vitest/hoisted-apis-on-top": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-conditional-tests": "off",
    "vitest/no-disabled-tests": "off",
    "vitest/no-focused-tests": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-standalone-expect": "off",
    "vitest/prefer-snapshot-hint": "off",
    "vitest/require-awaited-expect-poll": "off",
    "vitest/require-local-test-context-for-concurrent-snapshots": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/valid-describe-callback": "off",
    "vitest/valid-expect": "error",
    "vitest/valid-expect-in-promise": "off",
    "vitest/valid-title": "error",
    "vitest/warn-todo": "off",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-unknown-classes": "error",
    "jsx-a11y/anchor-has-content": "off",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      // Seeded PRNGs (demo data) and a 32-bit string hash are bitwise by nature.
      "files": ["src/lib/demo.ts", "src/lib/demo-own.ts", "shared/scoring.ts"],
      "rules": {
        "no-bitwise": "off"
      }
    },
    {
      // Sequential on purpose: cursor pagination, GitHub's rate limits, and the Worker's subrequest budget.
      "files": [
        "worker/api.ts",
        "worker/cron.ts",
        "worker/db.ts",
        "worker/github.ts",
        "src/lib/mine.ts",
        "src/lib/queries.ts"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "no-await-in-loop": "off",
        "shadcn/no-unknown-classes": "off",
        // A wrong assertion in a test fails that test where it happens.
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
